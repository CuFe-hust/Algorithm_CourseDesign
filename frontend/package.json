{
  "name": "algorithm-course-platform-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json pnpm-workspace.yaml",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig.json package.json pnpm-workspace.yaml"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "dompurify": "^3.2.0",
    "highlight.js": "^11.11.0",
    "katex": "^0.16.21",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.1.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=11 <12"
  }
}
